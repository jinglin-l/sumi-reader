{
  "manifest_version": 2,
  "name": "Sumi Reader",
  "version": "1.0.0",
  "description": "Re-renders the current page as a clean, high-contrast article in the sumi explainer theme. Works offline and makes no network requests.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sumi-reader@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["activeTab", "storage"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Read in sumi style (Alt+Shift+R)",
    "default_icon": "icon.svg"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Toggle sumi reader on the current tab"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
